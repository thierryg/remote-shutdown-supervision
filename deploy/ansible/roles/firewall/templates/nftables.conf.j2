#!/usr/sbin/nft -f
# {{ ansible_managed }} - /etc/nftables.conf
# Inbound: default DROP. Allowed: loopback, replies, ICMP essentials, DHCP, mDNS (LAN), SSH
# from rsd_admin_networks (rate-limited), the console 8443/tcp, the agent hub 8444/tcp and the
# discovery 50000/udp from rsd_lan_networks, node_exporter from the monitoring server.
# Outbound: allowed. Only the "rsd_filter" table is replaced on reload (fail2ban and Docker
# keep their own tables; no forward chain here, so Docker networking is untouched).
{% set lan4 = rsd_lan_networks | reject('search', ':') | list %}
{% set lan6 = rsd_lan_networks | select('search', ':') | list %}
{% set adm4 = rsd_admin_networks | reject('search', ':') | list %}
{% set adm6 = rsd_admin_networks | select('search', ':') | list %}
table inet rsd_filter
delete table inet rsd_filter

table inet rsd_filter {
{% for name, nets, family in [('lan_v4', lan4, 'ipv4_addr'), ('lan_v6', lan6, 'ipv6_addr'), ('admin_v4', adm4, 'ipv4_addr'), ('admin_v6', adm6, 'ipv6_addr')] %}
    set {{ name }} {
        type {{ family }}
        flags interval
{% if nets %}
        elements = { {{ nets | join(', ') }} }
{% endif %}
    }
{% endfor %}

    set ssh_meter_v4 {
        type ipv4_addr
        flags dynamic
        timeout 1m
    }
    set ssh_meter_v6 {
        type ipv6_addr
        flags dynamic
        timeout 1m
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept
        ct state invalid counter drop
        ct state established,related accept

        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
        ip protocol icmp icmp type echo-request limit rate 10/second accept
        ip6 nexthdr ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        ip6 nexthdr ipv6-icmp icmpv6 type echo-request limit rate 10/second accept

        udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
{% if rsd_mdns | bool %}

        ip saddr @lan_v4 udp dport 5353 accept
        ip6 saddr @lan_v6 udp dport 5353 accept
{% endif %}

        # SSH from the administration networks, 15 new connections per minute per source.
        ip saddr @admin_v4 tcp dport {{ rsd_ssh_port }} ct state new add @ssh_meter_v4 { ip saddr limit rate 15/minute } accept
        ip6 saddr @admin_v6 tcp dport {{ rsd_ssh_port }} ct state new add @ssh_meter_v6 { ip6 saddr limit rate 15/minute } accept

        # Remote Shutdown: console + enrollment, agent hub (mutual TLS), LAN discovery.
        ip saddr @lan_v4 tcp dport { {{ rsd_web_port }}, {{ rsd_agent_port }} } accept
        ip6 saddr @lan_v6 tcp dport { {{ rsd_web_port }}, {{ rsd_agent_port }} } accept
{% if rsd_discovery_enabled | bool %}
        ip saddr @lan_v4 udp dport {{ rsd_discovery_port }} accept
        ip6 saddr @lan_v6 udp dport {{ rsd_discovery_port }} accept
{% endif %}
{% if rsd_monitoring_server | length > 0 %}

        # Prometheus scrape of node_exporter from the monitoring server.
        {{ 'ip6' if ':' in rsd_monitoring_server else 'ip' }} saddr {{ rsd_monitoring_server }} tcp dport 9100 accept
{% endif %}
{% for rule in rsd_firewall_extra_rules %}
        {{ rule }}
{% endfor %}

        limit rate 6/minute log prefix "rsd-fw-drop: " level info
        counter drop comment "rsd dropped"
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
