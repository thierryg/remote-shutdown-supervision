# =============================================================================
# Remote Shutdown - LAN parental control and machine management (master/agent)
# -----------------------------------------------------------------------------
# File    : docker/Dockerfile.master
# Purpose : Container image of the master, on the same Python packages as the .deb (Ubuntu 26.04 LTS)
# Author  : Thierry Gayet <thierry.gayet@labworks.fr>
# Project : remote-shutdown (version: VERSION)
# Copyright (c) 2026 Thierry Gayet. SPDX-License-Identifier: 0BSD
# =============================================================================
# The master runs on the distribution's Python packages exactly like the rsd-master .deb
# (packaging/debian/master/control), with the same layout: /usr/lib/rsd-master, /usr/bin/rsd-master,
# data in /var/lib/rsd-master, unprivileged account rsd-master.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-fastapi python3-uvicorn \
      python3-cryptography python3-bcrypt python3-jwt ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY master/rsd_master /usr/lib/rsd-master/rsd_master
COPY VERSION /usr/lib/rsd-master/rsd_master/VERSION
COPY packaging/debian/rsd-master.sh /usr/bin/rsd-master
RUN chmod 0755 /usr/bin/rsd-master \
 && python3 -m compileall -q /usr/lib/rsd-master \
 && useradd --system --home-dir /var/lib/rsd-master --shell /usr/sbin/nologin rsd-master \
 && install -d -o rsd-master -g rsd-master -m 0750 /var/lib/rsd-master

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 RSD_CONFIG=/etc/rsd-master/master.ini
VOLUME ["/var/lib/rsd-master"]
EXPOSE 8443/tcp 8444/tcp 50000/udp
USER rsd-master
# The web console answers once the PKI and the database are ready.
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
  CMD ["python3", "-c", "import ssl, urllib.request; urllib.request.urlopen('https://127.0.0.1:8443/robots.txt', timeout=4, context=ssl._create_unverified_context())"]
ENTRYPOINT ["rsd-master"]
CMD ["serve"]
