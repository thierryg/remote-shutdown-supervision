# =============================================================================
# Remote Shutdown - LAN parental control and machine management (master/agent)
# -----------------------------------------------------------------------------
# File    : .gitignore
# Purpose : Files that must never be committed (build artifacts, secrets, runtime data)
# Author  : Thierry Gayet <thierry.gayet@labworks.fr>
# Project : remote-shutdown (version: VERSION)
# Copyright (c) 2026 Thierry Gayet. SPDX-License-Identifier: 0BSD
# =============================================================================
# --- Build artifacts -------------------------------------------------------------
/dist/
/build/
*.deb
*.msi
*.pkg
*.exe

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv-*/

# --- Secrets and PKI material: NEVER commit them -------------------------------
/certs/
*.key
*.pem
*.crt
*.csr
*.srl
*.p12
*.pfx
*.token
session.key

# --- Runtime data (development master: make run-master) ------------------------
/.dev/
*.db
*.db-wal
*.db-shm
*.log

# --- Archives, crash dumps -----------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip
core.[0-9]*

# --- Editors, OS and AI-agent local state ---------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
.claude/settings.local.json

# --- Local Docker test (docker/rsd-start.sh): exported CA, enrollment token ---
/docker/.local/
