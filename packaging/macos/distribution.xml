<installer-gui-script minSpecVersion="2">
  <title>Remote Shutdown Agent @VERSION@</title>
  <organization>com.labworks</organization>
  <license file="LICENSE.txt"/>
  <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>
  <volume-check>
    <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default"><line choice="com.labworks.rsd-agent"/></line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.labworks.rsd-agent" visible="false">
    <pkg-ref id="com.labworks.rsd-agent"/>
  </choice>
  <pkg-ref id="com.labworks.rsd-agent" version="@VERSION@" onConclusion="none">rsd-agent-component.pkg</pkg-ref>
</installer-gui-script>
