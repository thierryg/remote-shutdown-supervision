#!/bin/sh
# =============================================================================
# Remote Shutdown - LAN parental control and machine management (master/agent)
# -----------------------------------------------------------------------------
# File    : packaging/debian/master/prerm
# Purpose : Debian prerm: stop the master and remove the byte-compiled files
# Author  : Thierry Gayet <thierry.gayet@labworks.fr>
# Project : remote-shutdown (version: VERSION)
# Copyright (c) 2026 Thierry Gayet. SPDX-License-Identifier: 0BSD
# =============================================================================
set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop rsd-master-backup.timer rsd-master.service >/dev/null 2>&1 || true
      systemctl disable rsd-master-backup.timer rsd-master.service >/dev/null 2>&1 || true
    fi
    ;;
esac
find /usr/lib/rsd-master -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
exit 0
