set -e

case "$1" in
  remove|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop rsd-agent.service >/dev/null 2>&1 || true
      systemctl disable rsd-agent.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
